{
  "name": "campaign-flow-api",
  "version": "1.0.0",
  "description": "Clean architecture backend built with Fastify, TypeScript, and Prisma. Synchronizes Meta Ads mock accounts, campaigns, and metrics with PostgreSQL, implementing hexagonal architecture and concurrency-safe sync flows.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema=./src/infrastructure/database/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./src/infrastructure/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=./src/infrastructure/database/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/infrastructure/database/prisma/schema.prisma",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "keywords": [
    "fastify",
    "typescript",
    "prisma",
    "clean-architecture",
    "hexagonal-architecture"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.1.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@prisma/client": "^5.10.0",
    "axios": "^1.7.0",
    "fastify": "^5.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/ui": "^1.0.0",
    "prisma": "^5.10.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0"
  }
}
